{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned workflow planning purpose policy",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "output_types",
    "worker_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "const": "planning-review"
    },
    "output_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "implementation-plan",
          "synthesis",
          "recommendation",
          "strategy",
          "verification-recipe",
          "configuration-proposal",
          "source-plan"
        ]
      }
    },
    "worker_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
    }
  },
  "additionalProperties": false
}
