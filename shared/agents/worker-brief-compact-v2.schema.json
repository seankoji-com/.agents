{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable single-worker compact transport v2",
  "type": "object",
  "required": ["schema_version", "transport", "transport_instructions", "job_id", "stage_id", "logical_slot_id", "task_id", "request_id", "worker_id", "effective_brief_sha256", "requirements", "authorization", "constraints", "snapshot", "definition", "authority", "target_reason", "attempt", "max_attempts", "stop_conditions", "result_contract", "write_scope", "revision", "role", "artifact_limit_bytes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "transport": {"const": "worker-brief-compact-v2"},
    "transport_instructions": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "logical_slot_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "effective_brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements": {"type": "array"},
    "authorization": {"type": "object"},
    "constraints": {"type": "array"},
    "snapshot": {"type": ["object", "null"]},
    "definition": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["task_sha256", "manifest_sha256", "manifest_schema_sha256", "source_set_sha256", "procedure_sha256", "result_schema_sha256", "rubrics", "definition_sha256", "class", "package_digest", "transport_schema_sha256"],
      "properties": {
        "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "procedure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rubrics": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "class": {"enum": ["ordinary", "code-review", "configuration", "planning", "document-only"]},
        "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transport_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target_reason": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "stop_conditions": {"type": "array"},
    "result_contract": {"type": "object"},
    "write_scope": {"type": "object"},
    "revision": {"type": ["string", "null"]},
    "role": {"enum": ["worker", "review"]},
    "artifact_limit_bytes": {"type": "integer", "minimum": 1},
    "objective": {"type": "string"},
    "resources": {"type": "object"},
    "target": {"type": ["object", "null"]},
    "consumed_outputs": {"type": "array"},
    "owner_decisions": {"type": "array"},
    "review_inputs": {"type": "object"},
    "model_selection": {"type": "object"},
    "verification_tool": {"type": "object"},
    "document": {"type": "object"},
    "context_files": {"type": "array"},
    "followup_of": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
