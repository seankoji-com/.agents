{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-selection.schema.json",
  "title": "Frozen invocation model selection",
  "type": "object",
  "required": [
    "source",
    "coordinator",
    "capabilities",
    "profiles",
    "work",
    "invocation_id",
    "scope_id",
    "operation",
    "selection_sha256",
    "capabilities_sha256",
    "routing_sha256",
    "profiles_sha256",
    "schema_version",
    "routing",
    "review_panel",
    "work_replacements",
    "review_replacements"
  ],
  "properties": {
    "source": {
      "type": "object"
    },
    "coordinator": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "profiles": {
      "type": "object"
    },
    "work": {
      "type": "object"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "routing_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profiles_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": 1
    },
    "routing": {
      "type": [
        "object",
        "null"
      ]
    },
    "review_panel": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "role",
          "coverage",
          "required",
          "target"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "array",
            "minItems": 1
          },
          "required": {
            "type": "boolean"
          },
          "target": {
            "type": "object"
          }
        }
      }
    },
    "work_replacements": {
      "type": "array"
    },
    "review_replacements": {
      "type": "array"
    },
    "routing_scope": {
      "enum": [
        "invocation-only",
        "global"
      ],
      "description": "Owner workhorse routing intent, separate from invocation/scope IDs. This helper never persists routing."
    }
  },
  "additionalProperties": true
}
