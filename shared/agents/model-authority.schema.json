{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-authority.schema.json",
  "title": "Private scoped model replacement authority",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "grant",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant": {
      "type": "object",
      "required": [
        "scope",
        "project_id",
        "source",
        "recipients",
        "data_classes",
        "limits"
      ],
      "properties": {
        "scope": {
          "const": "standing-project"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "reference",
            "answer",
            "sha256"
          ]
        },
        "recipients": {
          "type": "array",
          "minItems": 1
        },
        "data_classes": {
          "type": "array",
          "minItems": 1
        },
        "limits": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false
}
