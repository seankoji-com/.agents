{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-contained immutable worker brief",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "stage_id",
    "logical_slot_id",
    "task_id",
    "request_id",
    "worker_id",
    "effective_brief_sha256",
    "requirements",
    "authorization",
    "constraints",
    "dependency_pins",
    "target_reason",
    "attempt",
    "max_attempts",
    "stop_conditions",
    "result_contract"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_slot_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "effective_brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirements": {
      "type": "array"
    },
    "authorization": {
      "type": "object"
    },
    "constraints": {
      "type": "array"
    },
    "dependency_pins": {
      "type": "object"
    },
    "target_reason": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "stop_conditions": {
      "type": "array"
    },
    "result_contract": {
      "type": "object"
    },
    "snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "objective": {
      "type": "string"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_definition": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "write_scope": {
      "type": "object"
    },
    "target": {
      "type": [
        "object",
        "null"
      ]
    },
    "consumed_outputs": {
      "type": "array"
    },
    "document": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "context_files": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "role": {
      "enum": [
        "worker",
        "review"
      ]
    },
    "review_inputs": {
      "type": "object"
    },
    "model_selection": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
