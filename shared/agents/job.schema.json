{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned generic job",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "installation_id",
    "workflow",
    "owner",
    "requirements",
    "authorization",
    "constraints",
    "dependencies",
    "stages",
    "pins",
    "policy",
    "tasks",
    "decisions",
    "history",
    "metrics",
    "result_contract"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ]
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorization": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshot": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "plugin"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/identifier"
          },
          "plugin": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "package_dir": {
            "type": "string",
            "minLength": 1
          },
          "bundle_dir": {
            "type": "string",
            "minLength": 1
          },
          "bundle_digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Finite job stage",
        "type": "object",
        "required": [
          "id",
          "depends_on",
          "requirements",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "awaiting-followup",
              "awaiting-acceptance",
              "accepted-at-snapshot",
              "blocked",
              "failed",
              "cancelled",
              "stale"
            ]
          },
          "criteria": {
            "type": "array"
          },
          "resources": {
            "type": "object"
          },
          "validator_dependency": {
            "type": "string",
            "minLength": 1
          },
          "attempts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "acceptance": {
            "type": [
              "object",
              "null"
            ]
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "outputs": {
            "type": "array"
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_history": {
            "type": "array"
          },
          "acceptance_runs": {
            "type": "integer",
            "minimum": 0
          },
          "cycle": {
            "type": "integer",
            "minimum": 0
          },
          "execution_mode": {
            "enum": [
              "direct",
              "workers"
            ]
          },
          "observation_ref": {
            "type": "object"
          },
          "independent_of_author": {
            "type": "boolean"
          },
          "lineage_waiver": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "package_digest"
        ],
        "properties": {
          "package_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "max_repair_cycles",
        "max_artifact_bytes"
      ],
      "properties": {
        "max_repair_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_live_workers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "identity": {"const": "observed"},
        "author_independence": {"type": "boolean"},
        "waivable_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "stage_id",
          "logical_slot_id",
          "request_id",
          "worker_id"
        ],
        "properties": {
          "task_id": {
            "$ref": "#/$defs/identifier"
          },
          "stage_id": {
            "$ref": "#/$defs/identifier"
          },
          "logical_slot_id": {
            "$ref": "#/$defs/identifier"
          },
          "request_id": {
            "$ref": "#/$defs/identifier"
          },
          "worker_id": {
            "$ref": "#/$defs/workerId"
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "awaiting-followup",
              "awaiting-acceptance",
              "accepted-at-snapshot",
              "blocked",
              "failed",
              "cancelled",
              "stale"
            ]
          },
          "handles": {
            "type": "array"
          },
          "followups": {
            "type": "array"
          },
          "dependency_key": {
            "type": "string"
          },
          "original_request_id": {
            "type": "string"
          },
          "last_completion_id": {
            "type": "string"
          },
          "last_execution_status": {
            "type": "string"
          },
          "blocked_reason": {
            "type": "string"
          },
          "dispatch_history": {
            "type": "array"
          },
          "execution_history": {
            "type": "array"
          },
          "retry_reasons": {
            "type": "array"
          },
          "finding_dispositions": {
            "type": "array"
          },
          "host_conflicts": {
            "type": "array"
          },
          "followup_dispatch": {
            "type": "object"
          },
          "capacity_retry_events": {
            "type": "array"
          },
          "reconciliation": {
            "type": "array"
          },
          "cycle": {
            "type": "integer",
            "minimum": 0
          },
          "dispatch_retries": {
            "type": "integer",
            "minimum": 0
          },
          "uncertain_calls": {
            "type": "integer",
            "minimum": 0
          },
          "brief": {
            "type": "object"
          },
          "result_ref": {
            "type": "object"
          },
          "target": {
            "type": [
              "object",
              "null"
            ]
          },
          "write_scope": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "coordinator-only",
                  "worker-evidence"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "capacity_deferred": {
            "type": "boolean"
          },
          "context_policy": {
            "enum": [
              "whole-stage",
              "document-only"
            ]
          },
          "document": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "max_followups": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "inputs_stale": {
            "type": "boolean"
          },
          "review_required": {
            "type": "boolean"
          },
          "independent_of_author": {"type": "boolean"},
          "document_authors": {"type": "array", "items": {"type": "object"}},
          "role": {
            "enum": [
              "worker",
              "review"
            ]
          },
          "review_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "reviewed_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "reviewed_documents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array"
    },
    "history": {
      "type": "array"
    },
    "metrics": {
      "type": "object"
    },
    "blockers": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "gaps": {
      "type": "array"
    },
    "fallbacks": {
      "type": "array"
    },
    "result_contract": {
      "type": "object",
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string"
    },
    "discard_requested": {
      "type": "object"
    },
    "plan_revisions": {
      "type": "array"
    },
    "notifications": {
      "type": "array"
    },
    "approval_waits": {
      "type": "array"
    },
    "final_passes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    }
  }
}
