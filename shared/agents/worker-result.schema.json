{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete worker result",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "stage_id",
    "logical_slot_id",
    "request_id",
    "worker_id",
    "effective_brief_sha256",
    "status",
    "conclusion",
    "requirements",
    "review_verdict",
    "findings",
    "gaps",
    "uncertainties",
    "changes",
    "commands",
    "artifacts",
    "revision",
    "binding",
    "extra_work_requests",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_slot_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "effective_brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ready-for-acceptance",
        "needs-followup",
        "blocked",
        "failed"
      ]
    },
    "conclusion": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unverified",
              "unavailable",
              "waived"
            ]
          },
          "evidence": {},
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "waived",
                  "unavailable",
                  "unverified"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          }
        ]
      }
    },
    "review_verdict": {
      "enum": [
        "approve",
        "adverse",
        "unavailable",
        null
      ]
    },
    "findings": {
      "type": "array"
    },
    "gaps": {
      "type": "array"
    },
    "uncertainties": {
      "type": "array"
    },
    "changes": {
      "type": "array"
    },
    "commands": {
      "type": "array"
    },
    "artifacts": {
      "type": "array"
    },
    "revision": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "binding": {
      "type": [
        "object",
        "null"
      ]
    },
    "extra_work_requests": {
      "type": "array"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "object",
            "required": [
              "value",
              "reason"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
