{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate planning job contract",
  "type": "object",
  "required": [
    "purpose",
    "dependency_key",
    "output_type",
    "subject_file",
    "snapshot",
    "passes",
    "attempts",
    "round",
    "attempts_per_candidate",
    "data_classes",
    "policy_sha256",
    "technical_limit",
    "sharing_revocations"
  ],
  "properties": {
    "purpose": {
      "const": "planning-review"
    },
    "dependency_key": {
      "type": "string",
      "minLength": 1
    },
    "output_type": {
      "type": "string",
      "minLength": 1
    },
    "subject_file": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "round": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "attempts_per_candidate": {
      "type": "integer",
      "const": 2
    },
    "data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explicit_data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "technical_limit": {
      "type": "integer",
      "minimum": 1
    },
    "sharing_revocations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
