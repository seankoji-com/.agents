{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-retention.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "specialized-definition",
              "shared-schema",
              "shared-procedure",
              "composer-framing"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "start_byte",
                "end_byte",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "source_id",
          "path",
          "kind",
          "sha256",
          "bytes",
          "clauses"
        ],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ordinary",
              "code-review",
              "configuration",
              "planning",
              "document-only"
            ]
          },
          "worker_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "clause_id": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "inline",
                    "coordinator-only",
                    "optional-reference"
                  ]
                },
                "justification": {
                  "type": "string",
                  "minLength": 1
                },
                "inline_text": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "clause_id",
                "disposition",
                "justification"
              ],
              "additionalProperties": false
            }
          },
          "procedure": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "text",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "result_contract_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "worker_ids",
          "rules",
          "procedure",
          "result_contract_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_set_sha256",
    "sources",
    "profiles"
  ],
  "additionalProperties": false
}
