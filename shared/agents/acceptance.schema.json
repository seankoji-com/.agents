{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative validator receipt",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "stage_id",
    "validator",
    "validator_sha256",
    "package_digest",
    "binding",
    "exit_code",
    "outcomes",
    "accepted",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "type": "string",
      "minLength": 1
    },
    "validator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "outcomes": {
      "type": "object"
    },
    "accepted": {
      "type": "boolean"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validator_argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "input_file": {
      "type": "string"
    },
    "stdout_sha256": {
      "type": "string"
    },
    "stderr_sha256": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
