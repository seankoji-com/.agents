{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "JSON report produced by `report`",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "outcome",
    "readiness",
    "requirements",
    "checks",
    "review",
    "reviews",
    "tasks",
    "resources",
    "blocker",
    "evidence_dir"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "planned",
        "executing",
        "verifying",
        "ready",
        "publishing",
        "completed",
        "blocked",
        "cancelling",
        "cancelled",
        "failed"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "stale",
        "blocked",
        "cancelled",
        "failed",
        "in_progress"
      ]
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "ready"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "stale",
            "incomplete",
            "failed"
          ]
        },
        "ready": {
          "type": "boolean"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unverified",
              "unavailable",
              "waived"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "required",
          "status",
          "argv"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unverified",
              "unavailable",
              "waived"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stale_reason": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unverified",
            "unavailable",
            "waived"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "verdict": {
          "enum": [
            "approve",
            "adverse",
            "unavailable"
          ]
        },
        "stale_reason": {
          "type": "string"
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "round",
          "verdict",
          "findings",
          "invalidated"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 1
          },
          "verdict": {
            "enum": [
              "approve",
              "adverse",
              "unavailable"
            ]
          },
          "host_task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "invalidated": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "blocker": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "reason",
            "task_ids",
            "resume"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "task_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resume": {
              "type": "object",
              "required": [
                "argv"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ]
      }
    },
    "evidence_dir": {
      "type": "string",
      "minLength": 1
    }
  }
}
