{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "brief",
    "readiness",
    "children",
    "notes",
    "remote"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "readiness": {
      "type": "object",
      "required": [
        "ready",
        "status",
        "binding",
        "requirements",
        "checks",
        "review",
        "missing",
        "failed",
        "stale",
        "counts",
        "remote_confirmed",
        "remote_reason",
        "outcome"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "failed",
            "stale",
            "incomplete"
          ]
        },
        "binding": {
          "type": "object",
          "required": [
            "snapshot",
            "contract_hash",
            "policy_hash"
          ],
          "properties": {
            "snapshot": {
              "type": "object",
              "required": [
                "worktree",
                "head",
                "content_hash"
              ],
              "properties": {
                "worktree": {
                  "type": "string",
                  "minLength": 1
                },
                "head": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "branch": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dirty_paths": {
                  "type": "integer"
                },
                "content_hash": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "contract_hash": {
              "type": "string",
              "minLength": 1
            },
            "policy_hash": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "kind",
              "required",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "inspection",
                  "command",
                  "runtime",
                  "manual"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unverified",
                  "unavailable",
                  "waived"
                ]
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "required",
              "status",
              "argv"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unverified",
                  "unavailable",
                  "waived"
                ]
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "required",
            "status"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "passed",
                "failed",
                "unverified",
                "unavailable",
                "waived"
              ]
            },
            "perspectives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "passed",
                      "failed",
                      "unverified",
                      "unavailable",
                      "waived"
                    ]
                  }
                }
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "obligation"
            ],
            "properties": {
              "obligation": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "obligation"
            ],
            "properties": {
              "obligation": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "stale": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "obligation"
            ],
            "properties": {
              "obligation": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "remote_confirmed": {
          "type": "boolean"
        },
        "remote_reason": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "cancelled",
            "blocked",
            "in_progress"
          ]
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "client_request_id",
          "parent_thread_id",
          "status",
          "has_pending_child_runs"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "client_request_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_thread_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "waiting",
              "completed",
              "failed",
              "cancelled",
              "interrupted"
            ]
          },
          "work_state": {
            "enum": [
              "working",
              "waiting_for_children",
              "result_available"
            ]
          },
          "has_pending_child_runs": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "remote": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
