{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission-policy.schema.json",
  "type": "object",
  "required": [
    "policy"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "required": [],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "argv"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "required": {
                "type": "boolean"
              },
              "repository_required": {
                "type": "boolean"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "waivable": {
              "type": "boolean"
            },
            "perspectives": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "brief_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role_overrides": {
          "type": "object"
        },
        "model_preferences": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
