{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "install-manifest.schema.json",
  "title": "Ownership manifest written by scripts/install.py",
  "type": "object",
  "required": [
    "schema_version",
    "plugin",
    "version",
    "source_commit",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "agents_root": {
      "type": "string",
      "minLength": 1
    },
    "bundle_dir": {
      "type": "string",
      "minLength": 1
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preserved_modified": {
      "type": "boolean",
      "description": "set by uninstall when locally modified owned files were kept"
    }
  },
  "additionalProperties": false
}
