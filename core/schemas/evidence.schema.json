{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "type": "object",
  "required": [
    "requirement_id",
    "status",
    "kind",
    "explanation",
    "snapshot",
    "contract_hash",
    "policy_hash",
    "recorded_at"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "unverified",
        "unavailable"
      ]
    },
    "kind": {
      "enum": [
        "inspection",
        "command",
        "runtime",
        "manual"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot": {
      "type": "object",
      "required": [
        "worktree",
        "head",
        "content_hash"
      ],
      "properties": {
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_paths": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contract_hash": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "invalidated": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
