{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe-facts.schema.json",
  "title": "Facts discovered by inspecting a repository, input to recipe-scaffold",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "prerequisites",
    "launch",
    "doctor",
    "cleanup",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "doctor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cmd"
      }
    },
    "cleanup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cmd"
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "steps",
          "expect",
          "observe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "observe": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          },
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/expect"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "launch": {
      "type": "object",
      "required": [
        "argv",
        "ready"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ready": {
          "type": "object",
          "required": [
            "kind",
            "timeout_seconds"
          ],
          "properties": {
            "kind": {
              "enum": [
                "http",
                "file"
              ]
            },
            "url": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        }
      }
    },
    "cmd": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "http",
            "command"
          ]
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string"
        },
        "body": {},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capture": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "http"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "command"
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    },
    "expect": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "status",
            "json_equals",
            "contains",
            "exit_code"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "equals": {},
        "text": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "status",
                "exit_code"
              ]
            }
          },
          "required": [
            "equals"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "json_equals"
            }
          },
          "required": [
            "path",
            "equals"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "contains"
            }
          },
          "required": [
            "text"
          ]
        }
      ]
    }
  }
}
