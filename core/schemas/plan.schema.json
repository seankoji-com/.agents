{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "brief"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "brief": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "worktree": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "endstate"
      ],
      "properties": {
        "local": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endstate": {
          "enum": [
            "local",
            "pr",
            "merge",
            "release"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "t3"
        },
        "parent_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "argv"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "required": {
                "type": "boolean"
              },
              "repository_required": {
                "type": "boolean"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "waivable": {
              "type": "boolean"
            },
            "perspectives": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "brief_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role_overrides": {
          "type": "object"
        },
        "model_preferences": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "inspection",
            "command",
            "runtime",
            "manual"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "chain"
      ],
      "properties": {
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chain_entry"
          }
        },
        "host_role": {
          "enum": [
            "implementation",
            "research",
            "review",
            "design",
            "test",
            "general"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "required": [
        "select"
      ],
      "properties": {
        "select": {
          "enum": [
            "inherit",
            "fixed",
            "catalog",
            "same_provider"
          ]
        },
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "options": {
          "type": "object"
        },
        "runtimeMode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "exclude_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "of_role": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "providerInstanceId"
      ],
      "properties": {
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object"
        },
        "runtimeMode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        }
      }
    }
  }
}
