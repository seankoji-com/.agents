{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Run plan accepted by init",
  "type": "object",
  "required": [
    "schema_version",
    "brief"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "brief": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "worktree": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "endstate"
      ],
      "properties": {
        "local": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endstate": {
          "enum": [
            "local",
            "pr",
            "merge",
            "release"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "delegated"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "isolation": {
          "enum": [
            "parallel",
            "serial",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "t3"
        },
        "parent_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_in"
      }
    },
    "labels": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "providerInstanceId"
      ],
      "properties": {
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object"
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "required": [
        "select"
      ],
      "properties": {
        "select": {
          "enum": [
            "inherit",
            "fixed",
            "catalog",
            "same_provider"
          ]
        },
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "options": {
          "type": "object"
        },
        "exclude_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "of_role": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": [
        "chain"
      ],
      "properties": {
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chain_entry"
          }
        },
        "host_role": {
          "enum": [
            "implementation",
            "research",
            "review",
            "design",
            "test",
            "general"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "name",
        "argv"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "required": {
          "type": "boolean"
        },
        "repository_required": {
          "type": "boolean"
        }
      }
    },
    "review_policy": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "waivable": {
          "type": "boolean"
        },
        "perspectives": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "review": {
          "$ref": "#/$defs/review_policy"
        },
        "repair_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "budget_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "worktree_root": {
          "type": "string"
        },
        "work_role": {
          "type": "string"
        },
        "brief_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/target"
          }
        },
        "model_preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "inspection",
            "command",
            "runtime",
            "manual"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "task_in": {
      "type": "object",
      "required": [
        "id",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "code",
            "read"
          ]
        },
        "executor": {
          "enum": [
            "self",
            "delegate"
          ]
        },
        "role": {
          "type": "string"
        },
        "writes": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_output": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "host_role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
