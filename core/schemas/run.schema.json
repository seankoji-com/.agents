{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "phase",
    "plugin",
    "repo",
    "brief",
    "authorization",
    "host",
    "roles",
    "policy",
    "children",
    "checks",
    "acceptance",
    "reviews",
    "waivers",
    "remote",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "active",
        "cancelled"
      ]
    },
    "plugin": {
      "type": "object"
    },
    "repo": {
      "type": "object"
    },
    "brief": {
      "type": "object",
      "required": [
        "text",
        "requirements",
        "constraints",
        "requirements_source"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements_source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "endstate"
      ],
      "properties": {
        "local": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endstate": {
          "enum": [
            "local",
            "pr",
            "merge",
            "release"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "t3"
        },
        "parent_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "policy": {
      "type": "object",
      "required": [],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "argv"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "required": {
                "type": "boolean"
              },
              "repository_required": {
                "type": "boolean"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "waivable": {
              "type": "boolean"
            },
            "perspectives": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "brief_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role_overrides": {
          "type": "object"
        },
        "model_preferences": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "client_request_id",
          "parent_thread_id",
          "status",
          "has_pending_child_runs"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "client_request_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_thread_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "waiting",
              "completed",
              "failed",
              "cancelled",
              "interrupted"
            ]
          },
          "work_state": {
            "enum": [
              "working",
              "waiting_for_children",
              "result_available"
            ]
          },
          "has_pending_child_runs": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "argv",
          "cwd",
          "exit_code",
          "snapshot",
          "contract_hash",
          "policy_hash",
          "recorded_at",
          "status",
          "artifact"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "type": "object",
            "required": [
              "worktree",
              "head",
              "content_hash"
            ],
            "properties": {
              "worktree": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dirty_paths": {
                "type": "integer"
              },
              "content_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contract_hash": {
            "type": "string",
            "minLength": 1
          },
          "policy_hash": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "invalidated": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable"
            ]
          },
          "artifact": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "status",
          "kind",
          "explanation",
          "snapshot",
          "contract_hash",
          "policy_hash",
          "recorded_at"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unverified",
              "unavailable"
            ]
          },
          "kind": {
            "enum": [
              "inspection",
              "command",
              "runtime",
              "manual"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "verifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "type": "object",
            "required": [
              "worktree",
              "head",
              "content_hash"
            ],
            "properties": {
              "worktree": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dirty_paths": {
                "type": "integer"
              },
              "content_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contract_hash": {
            "type": "string",
            "minLength": 1
          },
          "policy_hash": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "invalidated": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "perspective_id",
          "verdict",
          "findings",
          "artifacts",
          "snapshot",
          "contract_hash",
          "policy_hash",
          "recorded_at"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "perspective_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "approve",
              "adverse",
              "unavailable"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "summary"
              ],
              "properties": {
                "severity": {
                  "enum": [
                    "blocker",
                    "major",
                    "minor",
                    "note"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "selection": {
            "type": "object"
          },
          "why": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "required": [
              "worktree",
              "head",
              "content_hash"
            ],
            "properties": {
              "worktree": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dirty_paths": {
                "type": "integer"
              },
              "content_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contract_hash": {
            "type": "string",
            "minLength": 1
          },
          "policy_hash": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "invalidated": {
            "type": "string",
            "minLength": 1
          },
          "round": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "reason",
          "decided_by",
          "operator_quote",
          "snapshot",
          "contract_hash",
          "policy_hash",
          "recorded_at"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "decided_by": {
            "type": "string",
            "minLength": 1
          },
          "operator_quote": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "object",
            "required": [
              "worktree",
              "head",
              "content_hash"
            ],
            "properties": {
              "worktree": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dirty_paths": {
                "type": "integer"
              },
              "content_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contract_hash": {
            "type": "string",
            "minLength": 1
          },
          "policy_hash": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "invalidated": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "remote": {
      "type": "object",
      "required": [
        "receipts",
        "observations"
      ],
      "properties": {
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "kind",
              "url",
              "state",
              "head_sha"
            ],
            "properties": {
              "type": {
                "enum": [
                  "receipt",
                  "observation"
                ]
              },
              "kind": {
                "enum": [
                  "pr"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "open",
                  "merged",
                  "closed"
                ]
              },
              "head_sha": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "kind",
              "url",
              "state",
              "head_sha"
            ],
            "properties": {
              "type": {
                "enum": [
                  "receipt",
                  "observation"
                ]
              },
              "kind": {
                "enum": [
                  "pr"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "open",
                  "merged",
                  "closed"
                ]
              },
              "head_sha": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "inspection",
            "command",
            "runtime",
            "manual"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "chain"
      ],
      "properties": {
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chain_entry"
          }
        },
        "host_role": {
          "enum": [
            "implementation",
            "research",
            "review",
            "design",
            "test",
            "general"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "required": [
        "select"
      ],
      "properties": {
        "select": {
          "enum": [
            "inherit",
            "fixed",
            "catalog",
            "same_provider"
          ]
        },
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "options": {
          "type": "object"
        },
        "runtimeMode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "exclude_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "of_role": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "providerInstanceId"
      ],
      "properties": {
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object"
        },
        "runtimeMode": {
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "requirement_id",
        "status",
        "kind",
        "explanation",
        "snapshot",
        "contract_hash",
        "policy_hash",
        "recorded_at"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unverified",
            "unavailable"
          ]
        },
        "kind": {
          "enum": [
            "inspection",
            "command",
            "runtime",
            "manual"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "verifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "type": "object",
          "required": [
            "worktree",
            "head",
            "content_hash"
          ],
          "properties": {
            "worktree": {
              "type": "string",
              "minLength": 1
            },
            "head": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty_paths": {
              "type": "integer"
            },
            "content_hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "invalidated": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "name",
        "argv",
        "cwd",
        "exit_code",
        "snapshot",
        "contract_hash",
        "policy_hash",
        "recorded_at",
        "status",
        "artifact"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "type": "object",
          "required": [
            "worktree",
            "head",
            "content_hash"
          ],
          "properties": {
            "worktree": {
              "type": "string",
              "minLength": 1
            },
            "head": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty_paths": {
              "type": "integer"
            },
            "content_hash": {
              "type": "string",
              "minLength": 1
            }
          }
