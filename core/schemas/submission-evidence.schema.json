{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission-evidence.schema.json",
  "type": "object",
  "required": [
    "binding",
    "requirement_id",
    "status",
    "kind",
    "explanation"
  ],
  "properties": {
    "binding": {
      "type": "object",
      "required": [
        "snapshot",
        "contract_hash",
        "policy_hash"
      ],
      "properties": {
        "snapshot": {
          "type": "object",
          "required": [
            "worktree",
            "head",
            "content_hash"
          ],
          "properties": {
            "worktree": {
              "type": "string",
              "minLength": 1
            },
            "head": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty_paths": {
              "type": "integer"
            },
            "content_hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "unverified",
        "unavailable"
      ]
    },
    "kind": {
      "enum": [
        "inspection",
        "command",
        "runtime",
        "manual"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verifier": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
