{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission-review.schema.json",
  "type": "object",
  "required": [
    "binding",
    "task_id",
    "perspective_id",
    "verdict",
    "findings",
    "artifacts"
  ],
  "properties": {
    "binding": {
      "type": "object",
      "required": [
        "snapshot",
        "contract_hash",
        "policy_hash"
      ],
      "properties": {
        "snapshot": {
          "type": "object",
          "required": [
            "worktree",
            "head",
            "content_hash"
          ],
          "properties": {
            "worktree": {
              "type": "string",
              "minLength": 1
            },
            "head": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty_paths": {
              "type": "integer"
            },
            "content_hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "perspective_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "approve",
        "adverse",
        "unavailable"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "summary"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "note"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "selection": {
      "type": "object"
    },
    "why": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
