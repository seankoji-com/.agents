{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task as stored in run.json (same as run.schema.json $defs/task)",
  "type": "object",
  "required": [
    "id",
    "purpose",
    "status",
    "rounds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "code",
        "read",
        "review",
        "probe"
      ]
    },
    "executor": {
      "enum": [
        "self",
        "delegate"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "writes": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "pending",
        "active",
        "awaiting_text",
        "correction_needed",
        "accepted",
        "integrated",
        "blocked",
        "cancelled",
        "failed",
        "unavailable"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/target"
        }
      ]
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "correction_used": {
      "type": "boolean"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "providerInstanceId"
      ],
      "properties": {
        "providerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object"
        }
      }
    },
    "round": {
      "type": "object",
      "required": [
        "round",
        "purpose"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "enum": [
            "initial",
            "correction",
            "repair",
            "self"
          ]
        },
        "client_request_id": {
          "type": "string"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "child_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "wait_timed_out": {
          "type": "boolean"
        },
        "observations": {
          "type": "array"
        },
        "cancel": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
