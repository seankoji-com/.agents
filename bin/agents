#!/usr/bin/env python3
"""Operational commands use installed infrastructure; development selects source."""
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
if sys.version_info < (3, 10):
    sys.exit('agents requires Python 3.10+; invoke this file with the supported installation interpreter')
args = sys.argv[1:]
if args[:1] == ['self-install']:
    os.execv(sys.executable, [sys.executable, '-I', str(ROOT / 'scripts/agents_bootstrap.py'), *args])
if args[:1] == ['dev']:
    args = ['--source', str(ROOT), *args[1:]]
launcher = Path.home() / '.local/bin/agents'
if not launcher.is_file() or launcher.resolve() == Path(__file__).resolve():
    sys.exit('stable agents launcher is missing; run an explicit source self-install first')
os.execv(str(launcher), [str(launcher), *args])
