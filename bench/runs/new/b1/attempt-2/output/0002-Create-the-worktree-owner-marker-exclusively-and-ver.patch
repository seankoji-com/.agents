From 1c098e867df310138d1203befb4ae3c442e6551e Mon Sep 17 00:00:00 2001
From: Sean Carey <seankojicarey@gmail.com>
Date: Sun, 11 Oct 2026 21:57:34 +1100
Subject: [PATCH 2/2] Create the worktree owner marker exclusively and verify
 it

Review of the previous commit found two ways the owner marker could fail
open. A marker that was written but could not be read back recorded
owner None, so a recreated worktree without a marker matched again. And
the write followed an existing file or symlink at the marker path,
truncating its target.

Claiming a worktree now creates the marker with O_CREAT|O_EXCL, refuses
an existing marker as worktree_not_fresh, and fails unless the marker
reads back as the requested owner. A marker whose bytes do not decode is
treated as not this run's. Tests cover the prune path, the symlink, the
unreadable marker and the undecodable marker.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 core/resources.py     | 25 ++++++++++++++------
 tests/test_cleanup.py | 54 ++++++++++++++++++++++++++++++++++++++++---
 2 files changed, 69 insertions(+), 10 deletions(-)

diff --git a/core/resources.py b/core/resources.py
index b978bd2..1de028f 100644
--- a/core/resources.py
+++ b/core/resources.py
@@ -6,7 +6,7 @@ import os
 import subprocess
 from pathlib import Path
 
-from .errors import Environment
+from .errors import Environment, Prohibited
 
 
 def fingerprint(pid: int) -> str | None:
@@ -38,21 +38,32 @@ def worktree_identity(path) -> dict | None:
         return None
     try:
         found['owner'] = (Path(gitdir) / OWNER_MARKER).read_text()
-    except OSError:
+    except (OSError, ValueError):  # missing, unreadable or undecodable: not a marker this run wrote
         found['owner'] = None
     return found
 
 
-def claim_worktree(path, owner: str) -> dict | None:
-    """Write `owner` into a new worktree's admin directory and return its identity."""
+def claim_worktree(path, owner: str) -> dict:
+    """Write `owner` into a new worktree's admin directory and return its identity. The
+    marker is created exclusively (O_EXCL also refuses a symlink) and must read back,
+    or a recreated worktree without one would still match."""
     gitdir = _git(path, 'rev-parse', '--absolute-git-dir')
     if not gitdir:
-        return None
+        raise Environment('worktree_marker', f'{path} has no git admin directory to mark')
+    marker = Path(gitdir) / OWNER_MARKER
     try:
-        (Path(gitdir) / OWNER_MARKER).write_text(owner)
+        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+        with os.fdopen(fd, 'w') as stream:
+            stream.write(owner)
+    except FileExistsError as exc:
+        raise Prohibited('worktree_not_fresh', f'{marker} already exists; a pre-existing worktree '
+                                               'is never adopted as run-owned') from exc
     except OSError as exc:
         raise Environment('worktree_marker', f'cannot mark {path} as run-owned: {exc}') from exc
-    return worktree_identity(path)
+    found = worktree_identity(path)
+    if not found or found['owner'] != owner:
+        raise Environment('worktree_marker', f'the owner marker in {gitdir} does not read back')
+    return found
 
 
 def branch_identity(repo, branch) -> dict | None:
