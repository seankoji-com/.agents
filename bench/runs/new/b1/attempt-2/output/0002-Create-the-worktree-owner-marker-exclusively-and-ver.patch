+
+class WorktreeOwnerMarkerTest(CoreTestCase):
+    def worktree(self):
         repo = self.make_repo()
-        path = self.tmp / 'legacy'
+        path = self.tmp / 'owned'
+        git(repo, 'worktree', 'add', '-q', '--detach', str(path), 'HEAD')
+        return repo, path
+
+    def identity(self, path, recorded):
+        return resources.identity({'kind': 'worktree', 'path': str(path), 'identity': recorded})
+
+    def test_worktree_pruned_and_recreated_at_the_same_path_is_replaced(self):
+        repo, path = self.worktree()
+        recorded = resources.claim_worktree(path, 'run/R-1')
+        shutil.rmtree(path)
+        git(repo, 'worktree', 'prune')
         git(repo, 'worktree', 'add', '-q', '--detach', str(path), 'HEAD')
+        current = resources.worktree_identity(path)
+        self.assertEqual(current['gitdir'], recorded['gitdir'])
+        recorded.update(gitdir_inode=current['gitdir_inode'], dotgit_inode=current['dotgit_inode'])
+        self.assertEqual(self.identity(path, recorded), 'replaced')
+
+    def test_claim_never_writes_through_an_existing_marker(self):
+        repo, path = self.worktree()
+        target = self.write('elsewhere.txt', 'keep me\n')
+        gitdir = Path(git(path, 'rev-parse', '--absolute-git-dir').stdout.strip())
+        (gitdir / resources.OWNER_MARKER).symlink_to(target)
+        with self.assertRaises(Prohibited):
+            resources.claim_worktree(path, 'run/R-1')
+        self.assertEqual(target.read_text(), 'keep me\n')
+
+    @unittest.skipIf(hasattr(os, 'geteuid') and os.geteuid() == 0, 'root reads write-only files')
+    def test_claim_fails_when_the_marker_does_not_read_back(self):
+        repo, path = self.worktree()
+        previous = os.umask(0o444)
+        try:
+            with self.assertRaises(Environment):
+                resources.claim_worktree(path, 'run/R-1')
+        finally:
+            os.umask(previous)
+
+    def test_undecodable_marker_is_not_the_owner(self):
+        repo, path = self.worktree()
+        recorded = resources.claim_worktree(path, 'run/R-1')
+        (Path(recorded['gitdir']) / resources.OWNER_MARKER).write_bytes(b'\xff\xfe')
+        self.assertEqual(self.identity(path, recorded), 'replaced')
+
+    def test_worktree_identity_recorded_before_owner_markers_still_matches(self):
+        repo, path = self.worktree()
         recorded = resources.worktree_identity(path)
         del recorded['owner']
-        self.assertEqual(resources.identity({'kind': 'worktree', 'path': str(path), 'identity': recorded}), 'live')
+        self.assertEqual(self.identity(path, recorded), 'live')
