 class CleanupTest(CoreTestCase):
@@ -104,3 +109,47 @@ class CleanupTest(CoreTestCase):
             self.assertEqual(native(shlex.split(row['cleanup_command'])).returncode, 0, row)
         server.wait(timeout=10)
         self.assertEqual(git(repo, 'branch', '--list', 't3p/*').stdout.strip(), '')
+
+    def test_worktree_recreated_at_the_same_path_is_not_removed(self):
+        repo, run, t3, action, server = self.delegated_run()
+        tree = next(item for item in run.state['resources'] if item['kind'] == 'worktree')
+        path = Path(tree['path'])
+        git(repo, 'worktree', 'remove', '--force', str(path))
+        git(repo, 'worktree', 'add', '-q', '--detach', str(path), 'HEAD')
+        (path / 'someone-elses.txt').write_text('not run-owned\n')
+        # Git reuses the admin directory name, and ext4 and similar filesystems hand the
+        # freed inode numbers straight back. Make that reuse explicit where they did not.
+        state_file = run.run_dir / 'run.json'
+        data = json.loads(state_file.read_text())
+        recorded = next(item for item in data['resources'] if item['id'] == tree['id'])['identity']
+        self.assertEqual(git(path, 'rev-parse', '--absolute-git-dir').stdout.strip(), recorded['gitdir'])
+        recorded.update(gitdir_inode=os.stat(recorded['gitdir']).st_ino, dotgit_inode=os.lstat(path / '.git').st_ino)
+        state_file.write_text(json.dumps(data))
+        code, env, _ = cli('report', *run.args())
+        row = next(row for row in env['data']['report']['resources'] if row['id'] == tree['id'])
+        self.assertIsNone(row['cleanup_command'], 'no preserved-resource command for the recreated worktree')
+        data['phase'] = 'completed'
+        state_file.write_text(json.dumps(data))
+        while True:
+            cleanup = [a for a in run.next()['actions'] if a['action'] == 'cleanup']
+            if not cleanup:
+                break
+            args = cleanup[0]['args']
+            if args['kind'] == 'worktree':
+                self.assertEqual((args['identity'], args['argv']), ('replaced', None))
+            elif args['argv']:
+                native(args['argv'])
+            if args['kind'] == 'process':
+                server.wait(timeout=10)
+            run.record('cleanup', {'resource_id': args['resource_id'], 'exit_code': 0})
+        self.assertTrue((path / 'someone-elses.txt').is_file())
+        self.assertIn(str(path), git(repo, 'worktree', 'list').stdout)
+        self.assertEqual(next(item for item in run.state['resources'] if item['id'] == tree['id'])['status'], 'gone')
+
+    def test_worktree_identity_recorded_before_owner_markers_still_matches(self):
+        repo = self.make_repo()
+        path = self.tmp / 'legacy'
+        git(repo, 'worktree', 'add', '-q', '--detach', str(path), 'HEAD')
+        recorded = resources.worktree_identity(path)
+        del recorded['owner']
+        self.assertEqual(resources.identity({'kind': 'worktree', 'path': str(path), 'identity': recorded}), 'live')
