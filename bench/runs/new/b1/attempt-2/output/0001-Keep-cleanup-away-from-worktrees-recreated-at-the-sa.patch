From 1754dfc36ac40b24a56f42ca1ad99a6d5c5bc78b Mon Sep 17 00:00:00 2001
From: Sean Carey <seankojicarey@gmail.com>
Date: Sun, 11 Oct 2026 21:47:39 +1100
Subject: [PATCH 1/2] Keep cleanup away from worktrees recreated at the same
 path

A worktree's recorded identity was its admin directory path plus two inode
numbers. Recreating a worktree at the same path reuses the admin directory
name, and ext4 hands the freed inode numbers straight back, so a worktree
removed and re-added there matched the recorded identity and cleanup offered
`git worktree remove` for it.

Recording a worktree now writes an owner marker into its admin directory.
Git deletes that directory on `worktree remove` and `prune`, so a recreated
worktree has no marker and is reported replaced. Identities recorded before
this change have no owner key and keep their previous comparison.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 core/records.py       |  2 +-
 core/resources.py     | 36 +++++++++++++++++++++++++-----
 tests/test_cleanup.py | 51 ++++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 82 insertions(+), 7 deletions(-)

diff --git a/core/records.py b/core/records.py
index fd97b8e..9782c40 100644
--- a/core/records.py
+++ b/core/records.py
@@ -670,7 +670,7 @@ def rec_resource(ctx, state, payload):
         path, name, branch, task_id, probe, action_id = _created_worktree(ctx, state, payload)
         entry = {'id': rid, 'kind': 'worktree', 'name': name, 'path': str(path), 'branch': branch,
                  'task_id': task_id, 'status': 'live', 'created_at': ctx.at, 'created_by': action_id,
-                 'identity': resources.worktree_identity(path),
+                 'identity': resources.claim_worktree(path, f'{state["run_id"]}/{rid}'),
                  # Only a probe worktree, which holds nothing but the probe marker, is force-removed.
                  'cleanup_argv': ['git', '-C', repo, 'worktree', 'remove', *(['--force'] if probe else []), str(path)]}
         created.append(entry)
diff --git a/core/resources.py b/core/resources.py
index fff16f2..b978bd2 100644
--- a/core/resources.py
+++ b/core/resources.py
@@ -6,6 +6,8 @@ import os
 import subprocess
 from pathlib import Path
 
+from .errors import Environment
+
 
 def fingerprint(pid: int) -> str | None:
     out = subprocess.run(['ps', '-o', 'lstart=', '-o', 'command=', '-p', str(int(pid))], capture_output=True)
@@ -18,17 +20,39 @@ def _git(cwd, *args) -> str | None:
     return out.stdout.decode(errors='replace').strip() if out.returncode == 0 else None
 
 
+OWNER_MARKER = 't3p-owner'
+
+
 def worktree_identity(path) -> dict | None:
-    """The worktree's own `.git` file and admin directory: recreating a worktree at
-    the same path makes new ones."""
+    """The worktree's own `.git` file and admin directory, plus the owner marker kept in
+    that directory. Recreating a worktree at the same path reuses the admin directory
+    name, and filesystems such as ext4 reuse the freed inode numbers, but removing or
+    pruning a worktree deletes its admin directory and the marker with it."""
     gitdir = _git(path, 'rev-parse', '--absolute-git-dir')
     if not gitdir:
         return None
     try:
-        return {'gitdir': gitdir, 'gitdir_inode': os.stat(gitdir).st_ino,
-                'dotgit_inode': os.lstat(Path(path) / '.git').st_ino}
+        found = {'gitdir': gitdir, 'gitdir_inode': os.stat(gitdir).st_ino,
+                 'dotgit_inode': os.lstat(Path(path) / '.git').st_ino}
     except OSError:
         return None
+    try:
+        found['owner'] = (Path(gitdir) / OWNER_MARKER).read_text()
+    except OSError:
+        found['owner'] = None
+    return found
+
+
+def claim_worktree(path, owner: str) -> dict | None:
+    """Write `owner` into a new worktree's admin directory and return its identity."""
+    gitdir = _git(path, 'rev-parse', '--absolute-git-dir')
+    if not gitdir:
+        return None
+    try:
+        (Path(gitdir) / OWNER_MARKER).write_text(owner)
+    except OSError as exc:
+        raise Environment('worktree_marker', f'cannot mark {path} as run-owned: {exc}') from exc
+    return worktree_identity(path)
 
 
 def branch_identity(repo, branch) -> dict | None:
@@ -58,7 +82,9 @@ def _same(item: dict) -> bool:
     if not recorded:
         return True  # recorded before identities were kept
     if item['kind'] == 'worktree':
-        return worktree_identity(item['path']) == recorded
+        current = worktree_identity(item['path'])
+        # Identities recorded before owner markers have no 'owner' key; compare what was kept.
+        return current is not None and all(current.get(key) == value for key, value in recorded.items())
     if item['kind'] == 'branch':
         current = branch_identity(item['repo'], item['branch'])
         if current is None:
