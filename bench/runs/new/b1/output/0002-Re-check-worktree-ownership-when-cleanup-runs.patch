From bf96daef06a2eae64c5322995fd9858cc8a025f2 Mon Sep 17 00:00:00 2001
From: <worker git identity, redacted>
Date: Sun, 11 Oct 2026 21:28:10 +1100
Subject: [PATCH 2/2] Re-check worktree ownership when cleanup runs

The identity check ran when a cleanup command was offered and when it
was recorded, but not when it ran. A worktree deleted and recreated in
between was still removed by the command offered earlier, and a probe
worktree's forced removal would discard a dirty replacement.

The worktree cleanup command now wraps the removal in a short Python
guard that removes nothing unless the path still resolves to the
recorded admin directory and that directory still holds the run's
token. The token is read only from a regular file opened without
following links, so a FIFO planted there no longer blocks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 core/records.py       |  7 ++++---
 core/resources.py     | 36 ++++++++++++++++++++++++++++++++----
 tests/test_cleanup.py | 10 +++++++++-
 3 files changed, 45 insertions(+), 8 deletions(-)

diff --git a/core/records.py b/core/records.py
index d8040fc..e14e280 100644
--- a/core/records.py
+++ b/core/records.py
@@ -668,11 +668,12 @@ def rec_resource(ctx, state, payload):
     created = []
     if kind == 'worktree':
         path, name, branch, task_id, probe, action_id = _created_worktree(ctx, state, payload)
+        identity = resources.claim_worktree(path)
+        # Only a probe worktree, which holds nothing but the probe marker, is force-removed.
+        remove = ['git', '-C', repo, 'worktree', 'remove', *(['--force'] if probe else []), str(path)]
         entry = {'id': rid, 'kind': 'worktree', 'name': name, 'path': str(path), 'branch': branch,
                  'task_id': task_id, 'status': 'live', 'created_at': ctx.at, 'created_by': action_id,
-                 'identity': resources.claim_worktree(path),
-                 # Only a probe worktree, which holds nothing but the probe marker, is force-removed.
-                 'cleanup_argv': ['git', '-C', repo, 'worktree', 'remove', *(['--force'] if probe else []), str(path)]}
+                 'identity': identity, 'cleanup_argv': resources.guarded_removal(identity, path, remove)}
         created.append(entry)
         if branch:
             created.append({'id': f'R-{uuid.uuid4().hex[:8]}', 'kind': 'branch', 'name': name,
diff --git a/core/resources.py b/core/resources.py
index 59fc985..b028126 100644
--- a/core/resources.py
+++ b/core/resources.py
@@ -1,9 +1,12 @@
 """Run-owned resources: worktrees, branches and processes. Identity checks happen
-before any cleanup command is offered, so a reused PID is never signalled."""
+before any cleanup command is offered, so a reused PID is never signalled; worktree
+cleanup checks again when it runs."""
 from __future__ import annotations
 
 import os
+import stat
 import subprocess
+import sys
 import uuid
 from pathlib import Path
 
@@ -12,6 +15,15 @@ from .fsutil import atomic_write_bytes
 
 OWNER_FILE = 't3p-owner'  # in the worktree's admin directory, which git deletes with the worktree
 
+# Worktree cleanup re-checks ownership when it runs, not only when it is offered: it removes
+# nothing unless the path still resolves to the recorded admin directory and that directory
+# still holds the token. Arguments: admin directory, token, path, then the removal argv.
+_GUARD = ('import os,subprocess,sys;g,t,p,*r=sys.argv[1:];'
+          'd=subprocess.run(["git","-C",p,"rev-parse","--absolute-git-dir"],capture_output=True,text=True).stdout.strip();'
+          f'o=os.path.join(g,"{OWNER_FILE}");'
+          'ok=d==g and os.path.isfile(o) and not os.path.islink(o) and open(o,"rb").read(256).decode(errors="replace").strip()==t;'
+          'sys.exit(subprocess.run(r).returncode if ok else p+" is no longer the run-owned worktree; nothing removed")')
+
 
 def fingerprint(pid: int) -> str | None:
     out = subprocess.run(['ps', '-o', 'lstart=', '-o', 'command=', '-p', str(int(pid))], capture_output=True)
@@ -36,11 +48,22 @@ def worktree_identity(path) -> dict | None:
                  'dotgit_inode': os.lstat(Path(path) / '.git').st_ino}
     except OSError:
         return None
+    found['token'] = _read_token(Path(gitdir) / OWNER_FILE)
+    return found
+
+
+def _read_token(path: Path) -> str | None:
+    """Only a regular file holds a token; a link or FIFO planted there is read as none."""
     try:
-        found['token'] = (Path(gitdir) / OWNER_FILE).read_bytes().decode(errors='replace').strip()
+        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, 'O_NOFOLLOW', 0))
     except OSError:
-        found['token'] = None
-    return found
+        return None
+    try:
+        return os.read(fd, 256).decode(errors='replace').strip() if stat.S_ISREG(os.fstat(fd).st_mode) else None
+    except OSError:
+        return None
+    finally:
+        os.close(fd)
 
 
 def claim_worktree(path) -> dict:
@@ -55,6 +78,11 @@ def claim_worktree(path) -> dict:
     return found
 
 
+def guarded_removal(identity: dict, path, remove: list) -> list:
+    """The removal argv wrapped so it runs only while the claimed worktree is still at path."""
+    return [sys.executable or 'python3', '-c', _GUARD, identity['gitdir'], identity['token'], str(path), *remove]
+
+
 def branch_identity(repo, branch) -> dict | None:
     """The branch's creation entry in its reflog, plus its tip when recorded."""
     tip = _git(repo, 'rev-parse', '--verify', '-q', 'refs/heads/' + branch)
