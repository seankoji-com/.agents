From 9cd4831433e190459a4780a41e37052198da5c1b Mon Sep 17 00:00:00 2001
From: <worker git identity, redacted>
Date: Sun, 11 Oct 2026 21:18:24 +1100
Subject: [PATCH 2/2] Fail loudly when a worktree identity token cannot be read

Review of the previous commit found that any error reading the token,
such as a transient EACCES, counted as "no token": the still-owned
worktree was judged replaced and cleanup recorded it as gone for good.
A token that was not valid UTF-8 crashed `next` and `report` instead.

Only a missing token now means the worktree was replaced. Other read
errors raise an environment error, so nothing is recorded and cleanup
can resume once the error is fixed. Token bytes are decoded with
replacement, so a garbled token is a mismatch, not a crash.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 core/resources.py     | 11 +++++++---
 tests/test_cleanup.py | 48 +++++++++++++++++++++++++++++++++++--------
 2 files changed, 48 insertions(+), 11 deletions(-)

diff --git a/core/resources.py b/core/resources.py
index 5e69d95..82cf561 100644
--- a/core/resources.py
+++ b/core/resources.py
@@ -40,9 +40,14 @@ def worktree_identity(path) -> dict | None:
     except OSError:
         return None
     try:
-        found['token'] = (Path(gitdir) / TOKEN_FILE).read_text().strip() or None
-    except OSError:
-        found['token'] = None
+        raw = (Path(gitdir) / TOKEN_FILE).read_bytes()
+    except FileNotFoundError:
+        raw = b''
+    except OSError as exc:
+        # Unreadable is not absent: a transient error must not mark an owned worktree replaced.
+        raise Environment('worktree_identity', f'cannot read the identity token of {path}: '
+                                               f'{exc.strerror or exc}') from exc
+    found['token'] = raw.decode(errors='replace').strip() or None
     return found
 
 
