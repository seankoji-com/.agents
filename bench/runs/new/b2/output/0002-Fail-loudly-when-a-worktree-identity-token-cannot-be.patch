+    def test_unreadable_worktree_token_is_an_error_not_a_replacement(self):
+        repo, run, path = self.recorded_worktree()
+        self.complete(run)
+        token = Path(git(path, 'rev-parse', '--absolute-git-dir').stdout.strip()) / 't3-resource-token'
+        saved = token.read_bytes()
+        token.unlink()
+        token.mkdir()  # reading it fails with an error other than "missing"
+        code, env, _ = cli('next', *run.args('--parent-thread-id', run.parent))
+        self.assertEqual((code, env['error']['code']), (5, 'worktree_identity'))
+        token.rmdir()
+        token.write_bytes(saved)
+        cleanup = run.only('cleanup')
+        self.assertEqual((cleanup['args']['kind'], cleanup['args']['identity']), ('worktree', 'live'))
+        self.assertEqual(cleanup['args']['argv'][-1], str(path), 'the owned worktree is still cleaned up')
+
+    def test_garbled_worktree_token_is_a_replacement(self):
+        repo, run, path = self.recorded_worktree()
+        self.complete(run)
+        token = Path(git(path, 'rev-parse', '--absolute-git-dir').stdout.strip()) / 't3-resource-token'
+        token.write_bytes(b'\xff')
+        cleanup = run.only('cleanup')
+        self.assertEqual((cleanup['args']['kind'], cleanup['args']['identity'], cleanup['args']['argv']),
+                         ('worktree', 'replaced', None))
+        code, env, _ = cli('report', *run.args())
+        self.assertEqual(code, 0, env)
+
     def test_failed_integration_preserves_and_lists_resources(self):
