+
+    def test_worktree_recreated_at_the_same_path_is_never_removed(self):
+        repo = self.make_repo()
+        run = self.init(self.plan(repo, execution={'mode': 'delegated', 'isolation': 'parallel'},
+                                  tasks=[{'id': 'fix', 'purpose': 'fix counting', 'files': ['wordstat.py']}],
+                                  policy={'review': {'required': False, 'role': 'reviewer'}, 'checks': [],
+                                          'worktree_root': str(self.tmp / 'wt')}))
+        run.claim()
+        run.record('capabilities', {'response': capabilities()})
+        run.record('transition', {'to': 'executing'})
+        tree = run.only('create_worktree')
+        native(tree['args']['argv'])
+        run.record('resource', {'action_id': tree['id'], 'kind': 'worktree', 'name': tree['args']['name'],
+                                'path': tree['args']['path'], 'branch': tree['args']['branch'], 'task_id': 'fix'})
+        item = next(r for r in run.state['resources'] if r['kind'] == 'worktree')
+        path, branch = item['path'], item['branch']
+        self.assertEqual(engine.cleanup_action(item)['args']['identity'], 'live')
+        # Someone else removes it and checks the same branch out again at the same path:
+        # same name, commit and files. Only the creation differs.
+        git(repo, 'worktree', 'remove', path)
+        git(repo, 'worktree', 'add', '-q', path, branch)
+        # ext4 hands freed inode numbers straight back to the new worktree; model that
+        # on every filesystem by giving the record the new worktree's inodes.
+        state_file = run.run_dir / 'run.json'
+        data = json.loads(state_file.read_text())
+        recorded = next(r for r in data['resources'] if r['id'] == item['id'])['identity']
+        recorded.update(gitdir_inode=os.stat(recorded['gitdir']).st_ino,
+                        dotgit_inode=os.lstat(Path(path) / '.git').st_ino)
+        state_file.write_text(json.dumps(data))
+        item = next(r for r in run.state['resources'] if r['id'] == item['id'])
+        action = engine.cleanup_action(item)
+        self.assertEqual(action['args']['identity'], 'replaced')
+        self.assertIsNone(action['args']['argv'])
+        out = run.record('cleanup', {'resource_id': item['id']})
+        self.assertEqual(out['result']['status'], 'gone', out)
+        self.assertTrue((Path(path) / 'wordstat.py').is_file())
+        self.assertIn(path, git(repo, 'worktree', 'list', '--porcelain').stdout)
