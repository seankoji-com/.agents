         entry = {'id': rid, 'kind': 'worktree', 'name': name, 'path': str(path), 'branch': branch,
                  'task_id': task_id, 'status': 'live', 'created_at': ctx.at, 'created_by': action_id,
-                 'identity': resources.worktree_identity(path),
+                 'identity': identity,
                  # Only a probe worktree, which holds nothing but the probe marker, is force-removed.
                  'cleanup_argv': ['git', '-C', repo, 'worktree', 'remove', *(['--force'] if probe else []), str(path)]}
         created.append(entry)
diff --git a/core/resources.py b/core/resources.py
index fff16f2..9c9616f 100644
--- a/core/resources.py
+++ b/core/resources.py
@@ -4,8 +4,14 @@ from __future__ import annotations
 
 import os
 import subprocess
+import uuid
 from pathlib import Path
 
+# Written into a run-owned worktree's admin directory (.git/worktrees/<name>).
+# `git worktree remove` and `prune` delete that directory, so a worktree recreated
+# at the same path never carries the token, even when the filesystem reuses inodes.
+OWNER_FILE = 't3-owner'
+
 
 def fingerprint(pid: int) -> str | None:
     out = subprocess.run(['ps', '-o', 'lstart=', '-o', 'command=', '-p', str(int(pid))], capture_output=True)
@@ -19,16 +25,36 @@ def _git(cwd, *args) -> str | None:
 
 
 def worktree_identity(path) -> dict | None:
-    """The worktree's own `.git` file and admin directory: recreating a worktree at
-    the same path makes new ones."""
+    """The worktree's admin directory, its owner token and the inodes of that
+    directory and the `.git` file. Inode numbers alone are not enough: ext4 hands
+    them straight back to a worktree recreated at the same path."""
     gitdir = _git(path, 'rev-parse', '--absolute-git-dir')
     if not gitdir:
         return None
+    owner = Path(gitdir) / OWNER_FILE
     try:
+        token = owner.read_text().strip() if owner.is_file() and not owner.is_symlink() else None
         return {'gitdir': gitdir, 'gitdir_inode': os.stat(gitdir).st_ino,
-                'dotgit_inode': os.lstat(Path(path) / '.git').st_ino}
+                'dotgit_inode': os.lstat(Path(path) / '.git').st_ino, 'owner': token}
+    except OSError:
+        return None
+
+
+def claim_worktree(path) -> dict | None:
+    """Write a fresh owner token into the worktree's admin directory and return the
+    identity that includes it. None when the token cannot be written."""
+    gitdir = _git(path, 'rev-parse', '--absolute-git-dir')
+    if not gitdir:
+        return None
+    # Overwrite, so a record that failed after writing the token can be retried.
+    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, 'O_NOFOLLOW', 0)
+    try:
+        with os.fdopen(os.open(Path(gitdir) / OWNER_FILE, flags, 0o600), 'w') as out:
+            out.write(uuid.uuid4().hex + '\n')
     except OSError:
         return None
+    found = worktree_identity(path)
+    return found if found and found['owner'] else None
 
 
 def branch_identity(repo, branch) -> dict | None:
@@ -58,7 +84,9 @@ def _same(item: dict) -> bool:
     if not recorded:
         return True  # recorded before identities were kept
     if item['kind'] == 'worktree':
-        return worktree_identity(item['path']) == recorded
+        current = worktree_identity(item['path'])
+        # Identities recorded before owner tokens were kept have no 'owner' key.
+        return current is not None and all(current.get(key) == value for key, value in recorded.items())
     if item['kind'] == 'branch':
         current = branch_identity(item['repo'], item['branch'])
         if current is None:
