@@ -10,6 +10,8 @@ from pathlib import Path
 # Written into a run-owned worktree's admin directory (.git/worktrees/<name>).
 # `git worktree remove` and `prune` delete that directory, so a worktree recreated
 # at the same path never carries the token, even when the filesystem reuses inodes.
+# A checkout recreated and reattached with `git worktree repair` keeps the admin
+# directory; its new `.git` file has a new change time, which nothing can set back.
 OWNER_FILE = 't3-owner'
 
 
@@ -25,17 +27,21 @@ def _git(cwd, *args) -> str | None:
 
 
 def worktree_identity(path) -> dict | None:
-    """The worktree's admin directory, its owner token and the inodes of that
-    directory and the `.git` file. Inode numbers alone are not enough: ext4 hands
-    them straight back to a worktree recreated at the same path."""
+    """The worktree's admin directory and its owner token, plus the inodes of that
+    directory and the `.git` file and the `.git` file's change time. Inode numbers
+    alone are not enough: ext4 hands them straight back to a worktree recreated at
+    the same path."""
     gitdir = _git(path, 'rev-parse', '--absolute-git-dir')
     if not gitdir:
         return None
     owner = Path(gitdir) / OWNER_FILE
     try:
-        token = owner.read_text().strip() if owner.is_file() and not owner.is_symlink() else None
-        return {'gitdir': gitdir, 'gitdir_inode': os.stat(gitdir).st_ino,
-                'dotgit_inode': os.lstat(Path(path) / '.git').st_ino, 'owner': token}
+        # A corrupt token simply fails to match; it must not break cleanup or the report.
+        token = (owner.read_text(errors='replace').strip()
+                 if owner.is_file() and not owner.is_symlink() else None)
+        dotgit = os.lstat(Path(path) / '.git')
+        return {'gitdir': gitdir, 'gitdir_inode': os.stat(gitdir).st_ino, 'dotgit_inode': dotgit.st_ino,
+                'dotgit_ctime_ns': dotgit.st_ctime_ns, 'owner': token}
     except OSError:
         return None
 
@@ -85,7 +91,7 @@ def _same(item: dict) -> bool:
         return True  # recorded before identities were kept
     if item['kind'] == 'worktree':
         current = worktree_identity(item['path'])
-        # Identities recorded before owner tokens were kept have no 'owner' key.
+        # Identities recorded before owner tokens and change times were kept lack those keys.
         return current is not None and all(current.get(key) == value for key, value in recorded.items())
     if item['kind'] == 'branch':
         current = branch_identity(item['repo'], item['branch'])
