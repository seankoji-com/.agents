+    def test_worktree_recreated_at_the_same_path_is_never_removed(self):
+        repo, run, item = self.recorded_worktree()
+        # Someone else removes it and checks the same branch out again at the same path:
+        # same name, commit and files. Only the creation differs.
+        git(repo, 'worktree', 'remove', item['path'])
+        git(repo, 'worktree', 'add', '-q', item['path'], item['branch'])
+        self.assert_never_removed(repo, run, item)
+
+    def test_checkout_recreated_and_repaired_is_never_removed(self):
+        repo, run, item = self.recorded_worktree()
+        # The checkout is deleted and rebuilt; `git worktree repair` reattaches it to the
+        # surviving admin directory, owner token included.
+        shutil.rmtree(item['path'])
+        Path(item['path']).mkdir()
+        git(repo, 'worktree', 'repair')
+        git(Path(item['path']), 'reset', '-q', '--hard', 'HEAD')
+        self.assert_never_removed(repo, run, item)
+
+    def test_corrupt_owner_token_keeps_report_and_cleanup_usable(self):
+        repo, run, item = self.recorded_worktree()
+        (Path(item['identity']['gitdir']) / resources.OWNER_FILE).write_bytes(b'\xff\n')
+        self.assert_never_removed(repo, run, item)
