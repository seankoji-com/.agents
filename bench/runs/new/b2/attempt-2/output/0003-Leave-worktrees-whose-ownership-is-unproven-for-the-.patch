         if current is None:
@@ -104,13 +122,21 @@ def _same(item: dict) -> bool:
     return False
 
 
-def live(item: dict) -> bool:
-    """True only while the resource still exists and is still the one recorded."""
-    return _exists(item) and _same(item)
+def verdict(item: dict) -> tuple[str, str | None]:
+    """('live' | 'gone' | 'replaced' | 'unproven', why). 'replaced' means a PID, path or
+    branch name now used by something else; 'unproven' is a worktree that may still be
+    this run's but cannot be shown to be, with the reason."""
+    if not _exists(item):
+        return 'gone', None
+    if item['kind'] == 'worktree':
+        return _worktree(item)
+    return ('live' if _same(item) else 'replaced'), None
 
 
 def identity(item: dict) -> str:
-    """'live', 'gone' or 'replaced' (a PID, path or branch name now used by something else)."""
-    if not _exists(item):
-        return 'gone'
-    return 'live' if _same(item) else 'replaced'
