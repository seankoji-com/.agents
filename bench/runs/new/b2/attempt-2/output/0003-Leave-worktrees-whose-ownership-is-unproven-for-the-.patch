+def _worktree(item: dict) -> tuple[str, str | None]:
+    """Judge a worktree whose path still exists: ('live' | 'replaced' | 'unproven', why).
+    A different admin directory or owner token is someone else's worktree. The same
+    token with a rewritten `.git` file may be ours after `git worktree repair`, or a
+    checkout rebuilt and reattached: that, and any record without a token and change
+    time, is unproven, and cleanup leaves it for the operator."""
+    recorded = item.get('identity') or {}
+    current = worktree_identity(item['path'])
+    if current is None:
+        return 'replaced', None
+    if any(current.get(key) != recorded[key] for key in ('gitdir', 'gitdir_inode', 'owner') if key in recorded):
+        return 'replaced', None
+    if not recorded.get('owner') or 'dotgit_ctime_ns' not in recorded:
+        if 'dotgit_inode' in recorded and current['dotgit_inode'] != recorded['dotgit_inode']:
+            return 'replaced', None
+        return 'unproven', 'recorded before worktree ownership could be proven'
+    if (current['dotgit_inode'], current['dotgit_ctime_ns']) != (recorded['dotgit_inode'], recorded['dotgit_ctime_ns']):
+        return 'unproven', ('its .git file was rewritten after the run recorded it, by `git worktree repair` '
+                            'or because the checkout was rebuilt at the same path')
+    return 'live', None
+
+
