{
  "name": "babysitter",
  "version": "1.1.0",
  "description": "Maintain pull requests through review, CI, and authorized merge.",
  "argument_hint": "doctor | pr <URL> | repo <owner/name> | org <owner>",
  "entry": "entry.md",
  "model_invocable": true,
  "operations": [
    "doctor",
    "pr",
    "repo",
    "org"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "origin": {
    "repository": "seankoji-com/claude-plugins",
    "plugin": "babysitter",
    "version": "0.5.10"
  }
}
