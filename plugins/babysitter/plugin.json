{
  "name": "babysitter",
  "version": "1.2.8",
  "description": "Maintain pull requests through review, CI, and authorized merge.",
  "argument_hint": "doctor | pr <URL> | repo <owner/name> | org <owner>",
  "entry": "entry.md",
  "model_invocable": true,
  "operations": [
    "doctor",
    "pr",
    "repo",
    "org"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "origin": {
    "repository": "seankoji-com/claude-plugins",
    "plugin": "babysitter",
    "version": "0.5.10"
  },
  "workers": [
    {
      "id": "babysitter/pr-maintainer",
      "path": "agents/pr-maintainer.md",
      "operations": [
        "pr",
        "repo",
        "org"
      ],
      "role": "workhorse",
      "responsibility": "Maintain only the assigned PR within explicit authorization. Bind every claim to exact-head evidence.",
      "allowed_scope": "brief-authorized",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "babysitter/pr-reviewer",
      "path": "agents/pr-reviewer.md",
      "operations": [
        "pr",
        "repo",
        "org"
      ],
      "role": "reviewer",
      "responsibility": "Independently review the final combined PR changes at the exact head; do not modify or merge.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md",
    "reviewer-standard.md",
    "model-selection.schema.json",
    "model-authority.schema.json",
    "planning-policy.schema.json",
    "planning-job.schema.json",
    "planning-subject.schema.json",
    "planning-assessment.schema.json",
    "planning-direct.schema.json"
  ],
  "picker": [
    "pr",
    "repo",
    "org",
    "doctor"
  ],
  "routes": [
    {
      "pattern": "^doctor$",
      "operation": "doctor"
    },
    {
      "pattern": "^(?i:https?://github\\.com/[^/\\s]+/[^/\\s]+/pull/\\d+(?:[?#].*)?)$",
      "operation": "pr"
    },
    {
      "pattern": "^(?i:pr\\s+https?://github\\.com/[^/\\s]+/[^/\\s]+/pull/\\d+(?:[?#].*)?)$",
      "operation": "pr"
    },
    {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "operation": "repo"
    },
    {
      "pattern": "^repo\\s+[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "operation": "repo"
    },
    {
      "pattern": "^org\\s+[A-Za-z0-9_.-]+$",
      "operation": "org"
    }
  ],
  "planning_review": {
    "schema_version": 1,
    "purpose": "planning-review",
    "output_types": [
      "strategy"
    ],
    "worker_id": "babysitter/pr-reviewer"
  },
  "operation_review": {
    "doctor": {
      "selection": "direct",
      "planning": "none",
      "reason": "Local readiness has no synthesis."
    },
    "pr": {
      "selection": "upfront",
      "planning": "written-strategy",
      "reason": "Ordinary PR maintenance has no separate planning artifact; an actual repair/landing strategy reviews before dependent actions. Preserve requested final-head review, merge authority and sole native watcher."
    },
    "repo": {
      "selection": "upfront",
      "planning": "written-strategy",
      "reason": "Ordinary PR maintenance has no separate planning artifact; an actual repair/landing strategy reviews before dependent actions. Preserve requested final-head review, merge authority and sole native watcher."
    },
    "org": {
      "selection": "upfront",
      "planning": "written-strategy",
      "reason": "Ordinary PR maintenance has no separate planning artifact; an actual repair/landing strategy reviews before dependent actions. Preserve requested final-head review, merge authority and sole native watcher."
    }
  }
}
