{
  "name": "agent-tuneup",
  "version": "1.1.30",
  "description": "Audit and align centralized T3 provider wiring, shared rules, skills, permissions and MCPs with approved native changes.",
  "short_description": "Audit and align centralized T3 provider wiring",
  "argument_hint": "[scope or desired outcome]",
  "entry": "entry.md",
  "operations": [
    "tuneup"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "origin": {
    "repository": "seankoji-com/claude-plugins",
    "plugin": "claude-tuneup",
    "version": "0.1.19"
  },
  "workers": [
    {
      "id": "agent-tuneup/config-researcher",
      "path": "agents/config-researcher.md",
      "operations": [
        "tuneup"
      ],
      "role": "workhorse",
      "responsibility": "Research exact provider configuration format and scope semantics with authoritative source citations.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "agent-tuneup/config-verifier",
      "path": "agents/config-verifier.md",
      "operations": [
        "tuneup"
      ],
      "role": "reviewer",
      "responsibility": "Verify only explicitly authorized proposed or applied changes. Separate parse, load, and live enforcement evidence.",
      "allowed_scope": "brief-authorized",
      "output_contract": "worker-result.schema.json"
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md",
    "reviewer-standard.md",
    "model-selection.schema.json",
    "model-authority.schema.json",
    "planning-policy.schema.json",
    "planning-job.schema.json",
    "planning-subject.schema.json",
    "planning-assessment.schema.json",
    "planning-direct.schema.json"
  ],
  "picker": [
    "tuneup"
  ],
  "routes": [
    {
      "pattern": "^[\\s\\S]*$",
      "operation": "tuneup"
    }
  ],
  "planning_review": {
    "schema_version": 1,
    "purpose": "planning-review",
    "output_types": [
      "synthesis",
      "configuration-proposal",
      "recommendation"
    ],
    "worker_id": "agent-tuneup/config-verifier"
  },
  "operation_review": {
    "tuneup": {
      "selection": "upfront",
      "planning": "proposal",
      "reason": "Inventory, audit, inspect available usage, compare and review proposals in one workflow. Concrete owner approval still gates settings changes.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "playbooks/align.md",
      "completion_evidence": "reviewed audit/proposal; concrete owner approval and independent verification for settings application"
    }
  },
  "default_operation": "tuneup"
}
