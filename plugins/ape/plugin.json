{
  "name": "ape",
  "version": "1.0.36",
  "entry": "entry.md",
  "operations": [
    "doctor",
    "forage",
    "study",
    "clean"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "origin": {
    "repository": "seankoji-com/claude-plugins",
    "plugin": "ape",
    "version": "0.2.18"
  },
  "workers": [
    {
      "id": "ape/source-researcher",
      "path": "agents/source-researcher.md",
      "operations": [
        "forage",
        "study"
      ],
      "role": "workhorse",
      "responsibility": "Compare pinned source repositories. Record fingerprints, provenance, and transferable patterns without changing targets.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "ape/synthesizer",
      "path": "agents/synthesizer.md",
      "operations": [
        "forage",
        "study"
      ],
      "role": "judgement",
      "responsibility": "Compare accepted reports or challenge final research recommendations read-only under the shared planning contract.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md",
    "reviewer-standard.md",
    "model-selection.schema.json",
    "model-authority.schema.json",
    "planning-policy.schema.json",
    "planning-job.schema.json",
    "planning-subject.schema.json",
    "planning-assessment.schema.json",
    "planning-direct.schema.json"
  ],
  "picker": [
    "forage"
  ],
  "routes": [
    {
      "pattern": "^[\\s\\S]*(?i:https?://)\\S+[\\s\\S]*$",
      "operation": "study"
    },
    {
      "pattern": "^--doctor$",
      "operation": "doctor"
    },
    {
      "pattern": "^--clean\\s+\\S+(?:\\s+--all)?$",
      "operation": "clean"
    },
    {
      "pattern": "^[\\s\\S]*$",
      "operation": "forage"
    }
  ],
  "planning_review": {
    "schema_version": 1,
    "purpose": "planning-review",
    "output_types": [
      "synthesis"
    ],
    "worker_id": "ape/synthesizer"
  },
  "operation_review": {
    "doctor": {
      "selection": "direct",
      "planning": "none",
      "reason": "Local readiness has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "diagnostic exit and findings"
    },
    "clean": {
      "selection": "direct",
      "planning": "none",
      "reason": "Deterministic cleanup has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "playbooks/clean.md",
      "completion_evidence": "scoped owned-workspace cleanup receipt"
    },
    "study": {
      "selection": "upfront",
      "planning": "final-synthesis",
      "reason": "Final report including no-adoption output before acceptance.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "playbooks/study.md",
      "completion_evidence": "accepted pinned-source report"
    },
    "forage": {
      "selection": "upfront",
      "planning": "final-synthesis",
      "reason": "Review integrated synthesis including no experiment; research intermediates retain citation checks.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "playbooks/forage.md",
      "completion_evidence": "accepted comparative synthesis"
    }
  },
  "default_operation": "forage"
}
