{
  "name": "elephant-goldfish",
  "version": "1.0.7",
  "description": "Discover problems, write testable briefs, and verify design documents.",
  "short_description": "Discover problems, write briefs, verify design docs",
  "argument_hint": "doctor | thinking <topic> | thinking list | elephant [failure report] | check",
  "entry": "entry.md",
  "operations": [
    "doctor",
    "thinking",
    "elephant",
    "check"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "origin": {
    "repository": "seankoji-com/claude-plugins",
    "plugin": "elephant-goldfish",
    "version": "0.2.9"
  },
  "workers": [
    {
      "id": "elephant-goldfish/factual-checker",
      "path": "agents/factual-checker.md",
      "operations": [
        "elephant",
        "check"
      ],
      "role": "judgement",
      "responsibility": "Verify repository and command claims using cited evidence. Do not implement or infer unsupported facts."
    },
    {
      "id": "elephant-goldfish/cold-reader",
      "path": "agents/cold-reader.md",
      "operations": [
        "thinking",
        "elephant"
      ],
      "role": "reviewer",
      "responsibility": "Assess only the supplied document for usability and evidence. Do not inspect implementation or propose acceptance."
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md"
  ],
  "picker": [
    "doctor",
    "thinking",
    "elephant",
    "check"
  ],
  "routes": [
    {
      "pattern": "^(?i:doctor)$",
      "operation": "doctor"
    },
    {
      "pattern": "^(?i:(?:thinking|plan|design)\\b.*)$",
      "operation": "thinking"
    },
    {
      "pattern": "^(?i:(?:elephant|failure|incident)\\b.*)$",
      "operation": "elephant"
    },
    {
      "pattern": "^(?i:(?:check|verify)\\b.*)$",
      "operation": "check"
    }
  ]
}
