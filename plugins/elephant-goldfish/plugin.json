{
  "name": "elephant-goldfish",
  "version": "1.0.40",
  "description": "Discover problems, write testable briefs, and verify design documents.",
  "short_description": "Discover problems, write briefs, verify design docs",
  "argument_hint": "doctor | thinking <topic> | thinking list | elephant [failure report] | check",
  "entry": "entry.md",
  "operations": [
    "doctor",
    "thinking",
    "elephant",
    "check"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "origin": {
    "repository": "seankoji-com/claude-plugins",
    "plugin": "elephant-goldfish",
    "version": "0.2.9"
  },
  "workers": [
    {
      "id": "elephant-goldfish/factual-checker",
      "path": "agents/factual-checker.md",
      "operations": [
        "elephant",
        "check"
      ],
      "role": "judgement",
      "responsibility": "Verify repository and command claims using cited evidence. Do not implement or infer unsupported facts.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "elephant-goldfish/cold-reader",
      "path": "agents/cold-reader.md",
      "operations": [
        "thinking",
        "elephant"
      ],
      "role": "reviewer",
      "responsibility": "Assess only the supplied document for usability and evidence. Do not inspect implementation or propose acceptance.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "elephant-goldfish/plan-reviewer",
      "path": "agents/plan-reviewer.md",
      "operations": [
        "thinking",
        "elephant"
      ],
      "role": "judgement",
      "responsibility": "Challenge the exact source plan against the original request, accepted constraints and authorised repository evidence. Stay read-only and report complete planning coverage.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md",
    "reviewer-standard.md",
    "model-selection.schema.json",
    "model-authority.schema.json",
    "planning-policy.schema.json",
    "planning-job.schema.json",
    "planning-subject.schema.json",
    "planning-assessment.schema.json",
    "planning-direct.schema.json"
  ],
  "picker": [
    "thinking",
    "elephant",
    "check",
    "doctor"
  ],
  "routes": [
    {
      "pattern": "^doctor(?:\\s[\\s\\S]*)?$",
      "operation": "doctor"
    },
    {
      "pattern": "^thinking(?:\\s[\\s\\S]*)?$",
      "operation": "thinking"
    },
    {
      "pattern": "^elephant(?:\\s[\\s\\S]*)?$",
      "operation": "elephant"
    },
    {
      "pattern": "^check(?:\\s[\\s\\S]*)?$",
      "operation": "check"
    },
    {
      "pattern": "^[\\s\\S]*$",
      "operation": "thinking"
    }
  ],
  "planning_review": {
    "schema_version": 1,
    "purpose": "planning-review",
    "output_types": [
      "source-plan"
    ],
    "worker_id": "elephant-goldfish/plan-reviewer"
  },
  "operation_review": {
    "doctor": {
      "selection": "direct",
      "planning": "none",
      "reason": "Local readiness has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "diagnostic exit and findings"
    },
    "thinking": {
      "selection": "upfront",
      "planning": "source-plan",
      "reason": "Review discovery/spec before rendering; list/resolve/gate are deterministic.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "playbooks/thinking.md",
      "completion_evidence": "reviewed deterministic handoff and selected remote delivery; thinking list is direct"
    },
    "elephant": {
      "selection": "upfront",
      "planning": "design",
      "reason": "Review repaired design after factual acceptance and before cold-read dispatch.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "playbooks/elephant.md",
      "completion_evidence": "reviewed source document and selected remote delivery"
    },
    "check": {
      "selection": "on-delegation",
      "planning": "none",
      "reason": "Factual drift only; no newly authored plan and no cold read.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "read-only factual/cold-read findings; no publication authority"
    }
  },
  "deprecated": true,
  "replacement": "plan"
}
