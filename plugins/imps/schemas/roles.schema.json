{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roles.schema.json",
  "title": "imps role configuration (config.json roles, or a plan/repository policy roles override)",
  "description": "Selections are provider instance IDs and model IDs from the live T3 catalog, never aliases such as opus.",
  "type": "object",
  "required": ["implementer", "reviewer", "researcher"],
  "properties": {
    "implementer": {"$ref": "#/$defs/role"},
    "reviewer": {"$ref": "#/$defs/role"},
    "researcher": {"$ref": "#/$defs/role"}
  },
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "description": {"type": "string"},
        "host_role": {"enum": ["implementation", "research", "review", "design", "test", "general"]},
        "chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["select"],
      "properties": {
        "select": {"enum": ["inherit", "fixed", "catalog", "same_provider"]},
        "providerInstanceId": {"type": "string", "minLength": 1},
        "model": {"type": "string"},
        "options": {"type": "object"},
        "exclude_roles": {"type": "array", "items": {"enum": ["implementer", "reviewer", "researcher"]}},
        "of_role": {"enum": ["implementer", "reviewer", "researcher"]},
        "why": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
