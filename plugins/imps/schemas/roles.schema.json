{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roles.schema.json",
  "title": "imps role configuration (config.json roles, or a plan/repository policy roles override)",
  "description": "Matches the runtime: any role name is accepted (the shipped defaults are implementer, reviewer and researcher). Selections are provider instance IDs and model IDs from the live T3 catalog, never aliases such as opus.",
  "type": "object",
  "additionalProperties": {"$ref": "#/$defs/role"},
  "$defs": {
    "role": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "description": {"type": "string"},
        "host_role": {"enum": ["implementation", "research", "review", "design", "test", "general"]},
        "chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "entry": {
      "type": "object",
      "required": ["select"],
      "properties": {
        "select": {"enum": ["inherit", "fixed", "catalog", "same_provider"]},
        "providerInstanceId": {"type": "string", "minLength": 1},
        "model": {"type": "string"},
        "options": {"type": "object"},
        "runtimeMode": {"enum": ["approval-required", "auto-accept-edits", "auto", "full-access"]},
        "exclude_roles": {"type": "array", "items": {"type": "string"}},
        "of_role": {"type": "string", "minLength": 1},
        "why": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
