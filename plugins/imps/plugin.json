{
  "name": "imps",
  "version": "1.0.39",
  "description": "Bounded engineering work on any T3 provider: implement, investigate, audit, and review with revision-bound evidence.",
  "short_description": "Bounded engineering work with revision-bound evidence",
  "argument_hint": "doctor | run <task> | resume <run-id> | status <run-id> | cancel <run-id> | verification-init | blast-radius [PR/range/paths] | audit [--focus <dimensions>] [--out <path>] | issues <number> [<number> ...] | prs pr <URL> | prs repo <owner/name> | prs org <owner> | checklist <path> | discussion <number or URL>; add --personas before or after any request",
  "entry": "entry.md",
  "defaults": "config.json",
  "tested_t3_version": "0.0.46-nightly.20261008.2849",
  "operations": [
    "doctor",
    "run",
    "resume",
    "status",
    "cancel",
    "verification-init",
    "blast-radius",
    "audit",
    "issues",
    "prs",
    "checklist",
    "discussion"
  ],
  "kind": "workflow",
  "compatibility": "partial",
  "workers": [
    {
      "id": "imps/stage-executor",
      "path": "agents/stage-executor.md",
      "operations": [
        "run"
      ],
      "role": "workhorse",
      "responsibility": "Complete one assigned engineering stage, prepare verification, and report evidence without accepting your own work.",
      "allowed_scope": "brief-authorized",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "imps/investigator",
      "path": "agents/investigator.md",
      "operations": [
        "issues",
        "discussion"
      ],
      "role": "judgement",
      "responsibility": "Investigate the assigned question read-only. Cite exact paths, commands, and evidence; do not modify files.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "imps/auditor",
      "path": "agents/auditor.md",
      "operations": [
        "audit",
        "blast-radius"
      ],
      "role": "judgement",
      "responsibility": "Audit assigned dimensions. Separate confirmed findings, hypotheses, refutations, and evidence.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    },
    {
      "id": "imps/reviewer",
      "path": "agents/reviewer.md",
      "operations": [
        "run",
        "prs",
        "audit",
        "blast-radius",
        "issues",
        "checklist",
        "discussion",
        "verification-init"
      ],
      "role": "reviewer",
      "responsibility": "Review the exact supplied change snapshot independently. Report actionable findings with path, line, scenario, and evidence.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md",
    "reviewer-standard.md",
    "model-selection.schema.json",
    "model-authority.schema.json",
    "planning-policy.schema.json",
    "planning-assessment.schema.json",
    "planning-direct.schema.json",
    "planning-job.schema.json",
    "planning-subject.schema.json"
  ],
  "picker": [
    "run",
    "audit",
    "issues",
    "doctor"
  ],
  "routes": [
    {
      "pattern": "^(?:/imps:)?doctor(?:\\s[\\s\\S]*)?$",
      "operation": "doctor"
    },
    {
      "pattern": "^(?:/imps:)?resume(?:\\s[\\s\\S]*)?$",
      "operation": "resume"
    },
    {
      "pattern": "^(?:/imps:)?status(?:\\s[\\s\\S]*)?$",
      "operation": "status"
    },
    {
      "pattern": "^(?:/imps:)?cancel(?:\\s[\\s\\S]*)?$",
      "operation": "cancel"
    },
    {
      "pattern": "^(?:/imps:)?verification-init(?:\\s[\\s\\S]*)?$",
      "operation": "verification-init"
    },
    {
      "pattern": "^(?:/imps:)?blast-radius(?:\\s[\\s\\S]*)?$",
      "operation": "blast-radius"
    },
    {
      "pattern": "^(?:/imps:)?audit(?:\\s[\\s\\S]*)?$",
      "operation": "audit"
    },
    {
      "pattern": "^(?:/imps:)?issues(?:\\s[\\s\\S]*)?$",
      "operation": "issues"
    },
    {
      "pattern": "^(?:/imps:)?prs(?:\\s[\\s\\S]*)?$",
      "operation": "prs"
    },
    {
      "pattern": "^(?:/imps:)?checklist(?:\\s[\\s\\S]*)?$",
      "operation": "checklist"
    },
    {
      "pattern": "^(?:/imps:)?discussion(?:\\s[\\s\\S]*)?$",
      "operation": "discussion"
    },
    {
      "pattern": "^(?:/imps:)?imp-agency(?:\\s[\\s\\S]*)?$",
      "operation": "audit"
    },
    {
      "pattern": "^(?:/imps:)?issue-mode(?:\\s[\\s\\S]*)?$",
      "operation": "issues"
    },
    {
      "pattern": "^(?:/imps:)?(?:run|imps)\\s+(?:\\{\"issues\"[\\s\\S]*|#?[1-9][0-9]*(?:\\s+#?[1-9][0-9]*)*)$",
      "operation": "issues"
    },
    {
      "pattern": "^(?:/imps:)?(?:run|imps)\\s+(?:(?i:https://)github\\.com/[^/]+/[^/]+/discussions/[1-9][0-9]*/?(?:[?#][\\s\\S]*)?|discussion\\s+#?[1-9][0-9]*)$",
      "operation": "discussion"
    },
    {
      "pattern": "^(?:/imps:)?(?:run|imps)\\s+[\\s\\S]*\\.md$",
      "operation": "checklist"
    },
    {
      "pattern": "^(?:/imps:)?run(?:\\s[\\s\\S]*)?$",
      "operation": "run"
    },
    {
      "pattern": "^(?:/imps:)?imps(?:\\s[\\s\\S]*)?$",
      "operation": "run"
    },
    {
      "pattern": "^(?:\\{\"issues\"[\\s\\S]*|#?[1-9][0-9]*(?:\\s+#?[1-9][0-9]*)*)$",
      "operation": "issues"
    },
    {
      "pattern": "^(?:(?i:https://)github\\.com/[^/]+/[^/]+/discussions/[1-9][0-9]*/?(?:[?#][\\s\\S]*)?|discussion\\s+#?[1-9][0-9]*)$",
      "operation": "discussion"
    },
    {
      "pattern": "^[\\s\\S]*\\.md$",
      "operation": "checklist"
    },
    {
      "pattern": "^[\\s\\S]*$",
      "operation": "run"
    }
  ],
  "standalone_flags": [
    "--personas"
  ],
  "planning_review": {
    "schema_version": 1,
    "purpose": "planning-review",
    "output_types": [
      "implementation-plan",
      "synthesis",
      "recommendation",
      "strategy",
      "verification-recipe"
    ],
    "worker_id": "imps/reviewer"
  },
  "operation_review": {
    "doctor": {
      "selection": "direct",
      "planning": "none",
      "reason": "Local readiness has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "scripts/doctor.py",
      "completion_evidence": "diagnostic exit and findings"
    },
    "status": {
      "selection": "direct",
      "planning": "none",
      "reason": "State inspection has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "cli.py",
      "completion_evidence": "stored run state"
    },
    "cancel": {
      "selection": "direct",
      "planning": "none",
      "reason": "Owned-task cancellation has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "cli.py",
      "completion_evidence": "owned work stopped; partial evidence retained"
    },
    "resume": {
      "selection": "continuation",
      "planning": "retained-plan",
      "reason": "Reuse the scoped agreement and producing evidence without chooser; reconcile owned handles and retain findings/budgets.",
      "classification": "continuation",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "same contract, owned handles and remaining budgets"
    },
    "verification-init": {
      "selection": "upfront",
      "planning": "verification-recipe",
      "reason": "Review authored launch/drive/cleanup plan before execution; raw scaffold/check and unchanged reviewed recipe are direct.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "references/verification-init.md",
      "completion_evidence": "reviewed executable verification recipe; bare scaffold is direct"
    },
    "blast-radius": {
      "selection": "upfront",
      "planning": "final-synthesis",
      "reason": "Review integrated risks including no-risk conclusions.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "reviewed impact report"
    },
    "audit": {
      "selection": "upfront",
      "planning": "final-synthesis",
      "reason": "Review integrated conclusions and fix plan including zero findings.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "reviewed findings and retained refutations"
    },
    "prs": {
      "selection": "forward-once",
      "planning": "written-strategy",
      "reason": "Forward one selection to pinned babysitter; avoid duplicate imps planning gate.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "nested babysitter inherits agreement; each PR accounted for"
    },
    "run": {
      "selection": "upfront",
      "planning": "initial-plan",
      "reason": "Review before execution for write action, multiple stages or synthesis; raw fetch and unchanged accepted read checklist add no pass.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "current source gates and exact engineering endpoint"
    },
    "issues": {
      "selection": "upfront",
      "planning": "initial-plan",
      "reason": "Review before execution for write action, multiple stages or synthesis; raw fetch and unchanged accepted read checklist add no pass.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "accepted issue plan and selected authorised engineering endpoint"
    },
    "checklist": {
      "selection": "upfront",
      "planning": "initial-plan",
      "reason": "Review before execution for write action, multiple stages or synthesis; raw fetch and unchanged accepted read checklist add no pass.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "accepted checklist and selected authorised endpoint"
    },
    "discussion": {
      "selection": "upfront",
      "planning": "initial-plan",
      "reason": "Review before execution for write action, multiple stages or synthesis; raw fetch and unchanged accepted read checklist add no pass.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "accepted discussion-derived plan and selected endpoint"
    }
  }
}
