{
  "name": "ralph",
  "version": "0.1.46",
  "description": "Implement a goal with fresh T3 tasks, evaluate with another lineage, repair blockers and track safe deferrals as repository issues before the selected delivery endpoint.",
  "short_description": "Implement a goal, cross-evaluate it, retry before a PR",
  "argument_hint": "run [--max-attempts N] <goal> | resume <state-file> | status <state-file> | cancel <state-file> | doctor",
  "entry": "entry.md",
  "operations": [
    "run",
    "resume",
    "status",
    "cancel",
    "doctor"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "picker": [
    "run",
    "resume",
    "status",
    "doctor"
  ],
  "routes": [
    {
      "pattern": "^doctor(?:\\s[\\s\\S]*)?$",
      "operation": "doctor"
    },
    {
      "pattern": "^(?:run)(?:\\s[\\s\\S]*)?$",
      "operation": "run"
    },
    {
      "pattern": "^resume(?:\\s[\\s\\S]*)?$",
      "operation": "resume"
    },
    {
      "pattern": "^status(?:\\s[\\s\\S]*)?$",
      "operation": "status"
    },
    {
      "pattern": "^cancel(?:\\s[\\s\\S]*)?$",
      "operation": "cancel"
    },
    {
      "pattern": "^[\\s\\S]*$",
      "operation": "run"
    }
  ],
  "worker_shared": [
    "boundaries.md",
    "manifest.schema.json",
    "workers-config.schema.json",
    "job.schema.json",
    "stage.schema.json",
    "worker-brief.schema.json",
    "worker-result.schema.json",
    "result-envelope.schema.json",
    "acceptance.schema.json",
    "jobs-contract.md",
    "reviewer-standard.md",
    "model-selection.schema.json",
    "model-authority.schema.json",
    "planning-policy.schema.json",
    "planning-job.schema.json",
    "planning-subject.schema.json",
    "planning-assessment.schema.json",
    "planning-direct.schema.json"
  ],
  "workers": [
    {
      "id": "ralph/strategy-reviewer",
      "path": "agents/strategy-reviewer.md",
      "operations": [
        "run",
        "resume"
      ],
      "role": "judgement",
      "responsibility": "Challenge an explicitly authored strategy in a separate planning job; never replace Ralph final evaluation.",
      "allowed_scope": "read-only",
      "output_contract": "worker-result.schema.json"
    }
  ],
  "planning_review": {
    "schema_version": 1,
    "purpose": "planning-review",
    "output_types": [
      "strategy"
    ],
    "worker_id": "ralph/strategy-reviewer"
  },
  "operation_review": {
    "run": {
      "selection": "upfront",
      "planning": "written-strategy",
      "reason": "Ordinary loop has no initial planning artifact; written strategies automatically review before dependent work. Keep final full evaluator.",
      "classification": "substantive",
      "entry": "entry.md",
      "route": "playbooks/loop.md",
      "completion_evidence": "fresh full different-lineage evaluation and exact engineering endpoint"
    },
    "resume": {
      "selection": "continuation",
      "planning": "written-strategy",
      "reason": "Reuse the scoped agreement and producing evidence without chooser; reconcile owned handles and retain findings/budgets.",
      "classification": "continuation",
      "entry": "entry.md",
      "route": "playbooks/loop.md",
      "completion_evidence": "same agreement, author history, handles and remaining attempts"
    },
    "status": {
      "selection": "direct",
      "planning": "none",
      "reason": "State inspection has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "cli.py",
      "completion_evidence": "stored checkpoint"
    },
    "cancel": {
      "selection": "direct",
      "planning": "none",
      "reason": "Owned-task cancellation has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "cli.py",
      "completion_evidence": "owned work stopped; checkpoint retained"
    },
    "doctor": {
      "selection": "direct",
      "planning": "none",
      "reason": "Capability preflight has no synthesis.",
      "classification": "direct",
      "entry": "entry.md",
      "route": "entry.md",
      "completion_evidence": "diagnostic exit and findings"
    }
  }
}
