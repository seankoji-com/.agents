{
  "name": "ralph",
  "version": "0.1.19",
  "description": "Implement a goal with fresh T3 tasks, evaluate with another lineage, and retry every feedback item before opening a PR.",
  "short_description": "Implement a goal, cross-evaluate it, retry before a PR",
  "argument_hint": "run [--max-attempts N] <goal> | resume <state-file> | status <state-file> | cancel <state-file> | doctor",
  "entry": "entry.md",
  "operations": [
    "run",
    "resume",
    "status",
    "cancel",
    "doctor"
  ],
  "kind": "workflow",
  "compatibility": "experimental",
  "picker": [
    "run",
    "resume",
    "status",
    "doctor"
  ],
  "routes": [
    {
      "pattern": "^doctor(?:\\s[\\s\\S]*)?$",
      "operation": "doctor"
    },
    {
      "pattern": "^(?:run)(?:\\s[\\s\\S]*)?$",
      "operation": "run"
    },
    {
      "pattern": "^resume(?:\\s[\\s\\S]*)?$",
      "operation": "resume"
    },
    {
      "pattern": "^status(?:\\s[\\s\\S]*)?$",
      "operation": "status"
    },
    {
      "pattern": "^cancel(?:\\s[\\s\\S]*)?$",
      "operation": "cancel"
    },
    {
      "pattern": "^[\\s\\S]*$",
      "operation": "run"
    }
  ]
}
