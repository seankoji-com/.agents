{
  "schema_version": 1,
  "project": "notes",
  "prerequisites": [
    "python3"
  ],
  "variables": {
    "PORT": "free local port chosen at launch",
    "PID": "process id recorded at launch"
  },
  "launch": {
    "argv": [
      "python3",
      "app.py",
      "--port",
      "${PORT}"
    ],
    "ready": {
      "kind": "http",
      "url": "http://127.0.0.1:${PORT}/health",
      "timeout_seconds": 10
    }
  },
  "doctor": [
    {
      "argv": [
        "python3",
        "--version"
      ]
    }
  ],
  "cleanup": [
    {
      "argv": [
        "kill",
        "${PID}"
      ]
    }
  ],
  "features": [
    {
      "id": "F-CREATE",
      "name": "create note",
      "purpose": "store a note",
      "observe": "note listed",
      "steps": [
        {
          "kind": "http",
          "method": "POST",
          "url": "http://127.0.0.1:${PORT}/notes",
          "body": {
            "text": "hi"
          }
        }
      ],
      "expect": [
        {
          "kind": "status",
          "step": 1,
          "equals": 201
        }
      ]
    }
  ]
}
