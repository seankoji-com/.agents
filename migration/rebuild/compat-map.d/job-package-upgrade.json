{
  "schema_version": 1,
  "stage": 5,
  "inventory": {
    "helpers": [
      {
        "path": "shared/job_upgrade.py",
        "kind": "python-module",
        "disposition": "change",
        "stage": 5,
        "reason": "Explicit verified same-job dependency adoption with exact-state backup and owner-bound revision; preserves histories and counters and invalidates acceptance."
      }
    ],
    "cli_subcommands": [
      {
        "id": "shared.job_cli:upgrade-package",
        "path": "shared/job_cli.py",
        "disposition": "change",
        "stage": 5,
        "reason": "Narrow installed-package migration entry point; normal commands retain strict executing-package pin checks."
      }
    ],
    "tests": [
      {
        "path": "tests/test_job_upgrade.py",
        "disposition": "keep",
        "stage": 5,
        "reason": "Installed artifact migration, provenance, bounds and refusal regressions.",
        "assertions": [
          {
            "selector": "test_job_upgrade.InstalledUpgradeTests",
            "coverage": [
              "REQ-COMPAT",
              "REQ-BOUNDARIES",
              "REQ-DELIVERY"
            ],
            "survives": true
          },
          {
            "selector": "test_job_upgrade.BoundsTests",
            "coverage": [
              "REQ-BOUNDARIES"
            ],
            "survives": true
          }
        ]
      }
    ]
  }
}
